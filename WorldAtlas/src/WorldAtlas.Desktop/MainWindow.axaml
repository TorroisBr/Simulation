<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:WorldAtlas.Desktop.Controls"
        x:Class="WorldAtlas.Desktop.MainWindow"
        Title="World Atlas"
        Width="1460" Height="920" MinWidth="1120" MinHeight="720"
        Background="#111722"
        FontFamily="Segoe UI">
  <Window.Styles>
    <Style Selector="Button.atlas-action">
      <Setter Property="Background" Value="#263444" />
      <Setter Property="Foreground" Value="#E7EDF5" />
      <Setter Property="BorderBrush" Value="#3A4A5D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.atlas-action:pointerover">
      <Setter Property="Background" Value="#34465A" />
    </Style>
    <Style Selector="ToggleButton.nav-item">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#AAB7C8" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ToggleButton.nav-item:checked">
      <Setter Property="Background" Value="#273645" />
      <Setter Property="Foreground" Value="#E5F6EF" />
    </Style>
    <Style Selector="ListBox.atlas-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.atlas-list ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E7EDF5" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="ListBox.atlas-list ListBoxItem:selected">
      <Setter Property="Background" Value="#2C3D4E" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#98A7BA" />
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="#91A3B7" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="70,*,168" ColumnDefinitions="250,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#151D28" BorderBrush="#2C3745" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="250,*,Auto,Auto,Auto,Auto" Margin="18,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="34" Height="34" CornerRadius="10" Background="#254438" BorderBrush="#426F5C" BorderThickness="1">
            <TextBlock Text="A" Foreground="#B4F0D5" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="WORLD ATLAS" FontSize="13" FontWeight="Bold" />
            <TextBlock Text="Simulation · read-only explorer" Classes="muted" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="10,0,0,0">
          <TextBlock Text="OBSERVATION PAIR" Classes="section-label" VerticalAlignment="Center" Margin="0,0,4,0" />
          <ComboBox x:Name="BeforeCombo" Width="178" ItemsSource="{Binding ObservationChoices}" SelectedItem="{Binding BeforeChoice}" />
          <TextBlock Text="→" Classes="muted" FontSize="18" VerticalAlignment="Center" />
          <ComboBox x:Name="AfterCombo" Width="178" ItemsSource="{Binding ObservationChoices}" SelectedItem="{Binding AfterChoice}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="atlas-action" Content="Compare" Click="OnCompareClick" VerticalAlignment="Center" Margin="8,0" />
        <Button Grid.Column="3" Classes="atlas-action" Content="Open JSON…" Click="OnOpenClick" VerticalAlignment="Center" Margin="8,0" />
        <Border Grid.Column="4" Background="#463B25" BorderBrush="#887143" BorderThickness="1" CornerRadius="8" Padding="10,6" VerticalAlignment="Center" Margin="8,0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="7" Height="7" Fill="#F0C96E" VerticalAlignment="Center" />
            <TextBlock Text="DEMO DATA" Foreground="#F1D99D" FontSize="11" FontWeight="Bold" />
          </StackPanel>
        </Border>
        <Button Grid.Column="5" Classes="atlas-action" Content="About" Click="OnAboutClick" VerticalAlignment="Center" Margin="8,0,0,0" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="#151D28" BorderBrush="#2C3745" BorderThickness="0,0,1,0" Padding="14,18">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="WORKSPACE" Classes="section-label" Margin="8,0,0,10" />
        <ToggleButton x:Name="WorldNav" Grid.Row="1" Classes="nav-item" Content="◉   World overview" Click="OnWorldClick" />
        <ToggleButton x:Name="HexNav" Grid.Row="2" Classes="nav-item" Content="⬡   Hexes" IsChecked="True" Click="OnHexesClick" />
        <ToggleButton x:Name="LocationNav" Grid.Row="3" Classes="nav-item" Content="⌖   Locations" Click="OnLocationsClick" />
        <ToggleButton x:Name="CityNav" Grid.Row="4" Classes="nav-item" Content="▦   Cities" Click="OnCitiesClick" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" Margin="8,24,0,8">
          <TextBlock Text="ENTITIES" Classes="section-label" VerticalAlignment="Center" />
          <Border Width="23" Height="20" Background="#253243" CornerRadius="6" VerticalAlignment="Center">
            <TextBlock Text="{Binding EntityCount}" FontSize="10" Foreground="#B7C6D8" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </StackPanel>
        <ListBox x:Name="EntityList" Grid.Row="6" Classes="atlas-list" ItemsSource="{Binding EntityItems}" SelectedItem="{Binding SelectedNavigationItem}" SelectionChanged="OnEntitySelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="7" Background="#1D2835" BorderBrush="#334153" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,12,0,0">
          <StackPanel Spacing="4">
            <TextBlock Text="OFFLINE FIXTURE" Foreground="#B3C6D8" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="No Core or Unity connection" Classes="muted" FontSize="10" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,352" Margin="16,16,16,12">
      <Border Grid.Column="0" Background="#18212D" BorderBrush="#303D4E" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid RowDefinitions="62,*,44">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto" Margin="20,0">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding ViewTitle}" FontSize="17" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ViewSubtitle}" Classes="muted" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1" Classes="atlas-action" Content="−" Width="38" Padding="4" Click="OnZoomOutClick" VerticalAlignment="Center" Margin="5,0" />
            <Button Grid.Column="2" Classes="atlas-action" Content="+" Width="38" Padding="4" Click="OnZoomInClick" VerticalAlignment="Center" Margin="5,0" />
            <Button Grid.Column="3" Classes="atlas-action" Content="Fit map" Click="OnFitClick" VerticalAlignment="Center" Margin="8,0,0,0" />
          </Grid>
          <Border Grid.Row="1" Background="#121A24" Margin="12,0,12,0" CornerRadius="9" ClipToBounds="True">
            <controls:HexMapView x:Name="MapView" Hexes="{Binding MapHexes}" Markers="{Binding MapMarkers}" SelectedHexId="{Binding SelectedHexId}" />
          </Border>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="18,0">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#7EA985" /><TextBlock Text="Plain" Classes="muted" FontSize="10" /></StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#9F8D72" /><TextBlock Text="Hill" Classes="muted" FontSize="10" /></StackPanel>
              <TextBlock Text="L location · C City anchor · marker indicates Hex anchor, not a point location" Classes="muted" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding MapFooter}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#18212D" BorderBrush="#303D4E" BorderThickness="1" CornerRadius="12" Margin="14,0,0,0" Padding="18">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="INSPECTOR" Classes="section-label" />
          <StackPanel Grid.Row="1" Spacing="4" Margin="0,12,0,16">
            <TextBlock Text="{Binding SelectedEntityTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedEntityKindLabel}" Classes="muted" FontSize="11" />
          </StackPanel>
          <Border Grid.Row="2" Background="#202B39" BorderBrush="#354457" BorderThickness="1" CornerRadius="7" Padding="9,7" Margin="0,0,0,9">
            <TextBlock Text="{Binding SelectedEntityIdentity}" Foreground="#C3D4E7" FontSize="11" TextTrimming="CharacterEllipsis" />
          </Border>
          <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding InspectorFacts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#2E3A49" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayValue}" FontSize="11" TextWrapping="Wrap" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AvailabilityLabel}" Foreground="#83D2B3" FontSize="9" Margin="0,4,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="4" Text="Facts reflect the selected observation boundary." Classes="muted" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Grid.Column="1" Background="#18212D" BorderBrush="#303D4E" BorderThickness="1" CornerRadius="12" Margin="16,0,16,16" Padding="18,13">
      <Grid ColumnDefinitions="250,*" RowDefinitions="Auto,*">
        <StackPanel Grid.RowSpan="2" Spacing="5" VerticalAlignment="Top">
          <TextBlock Text="OBSERVATION COMPARISON" Classes="section-label" />
          <TextBlock Text="{Binding ComparisonHeadline}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,12,0" />
          <TextBlock Text="{Binding ComparisonScope}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding ComparisonSummary}" Foreground="#C3D0DE" FontSize="11" TextWrapping="Wrap" />
        <ItemsControl Grid.Column="1" Grid.Row="1" ItemsSource="{Binding Differences}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="#493D27" BorderBrush="#806B42" BorderThickness="1" CornerRadius="6" Padding="7,4">
                  <TextBlock Text="OBSERVED DIFFERENCE" Foreground="#F2D899" FontSize="9" FontWeight="Bold" />
                </Border>
                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Before.DisplayValue}" Foreground="#D8B48A" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="→" Classes="muted" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="{Binding After.DisplayValue}" Foreground="#9AD9BC" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Border>
  </Grid>
</Window>
